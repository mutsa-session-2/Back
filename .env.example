# Copy this file to ".env" and fill in real values. This file is ignored by Git.
# Database
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT (optional if you keep default)
JWT_SECRET=

# Swagger Basic Auth (optional; defaults are swagger / change-me)
APP_SWAGGER_BASIC_USERNAME=swagger
APP_SWAGGER_BASIC_PASSWORD=change-me

# BasicAuth is cached by browser per (origin + realm).
# Change this value and restart server to force the login prompt again.
APP_SWAGGER_BASIC_REALM_SUFFIX=-v1
